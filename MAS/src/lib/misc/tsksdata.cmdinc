) do (
for /f "tokens=1-3 delims=_" %%A in ("%%#") do (

if %1==chkprod if "%oVer%"=="%%A" if not defined foundprod (
if /i "%%B"=="%2" set foundprod=1
)

if %1==getinfo if "%oVer%"=="%%A" (
echo: %%C | find /i "-%2-" %nul% && (
set _License=%%B
set _altoffid=%%B
)
)

)
)
exit /b

